#!/bin/bash
# Post-push hook: run full validation then publish release
# Runs in background so it doesn't block the push

set -e

MIX_BIN="/Users/abby/.local/share/mise/shims/mix"
REPO_ROOT="$(git rev-parse --show-toplevel)"
export HEX_HOME="$REPO_ROOT/.cache/hex"
export MIX_HOME="$REPO_ROOT/.cache/mix"

BOT_NAME="dispatcher"
LOG_FILE="/tmp/post-push-validation-${BOT_NAME}-$(date +%s).log"

{
  echo "🔄 Post-push: Starting background validation..."
  echo ""

  # Run compile, credo, tests in parallel
  echo "🔨 Compiling..."
  COMPILE_LOG="/tmp/.post-push-compile-$$.log"
  "$MIX_BIN" compile >"$COMPILE_LOG" 2>&1 &
  COMPILE_PID=$!

  echo "📝 Running credo..."
  CREDO_LOG="/tmp/.post-push-credo-$$.log"
  "$MIX_BIN" credo --strict >"$CREDO_LOG" 2>&1 &
  CREDO_PID=$!

  echo "🧪 Running tests..."
  TEST_LOG="/tmp/.post-push-test-$$.log"
  "$MIX_BIN" test >"$TEST_LOG" 2>&1 &
  TEST_PID=$!

  # Wait for all checks
  wait $COMPILE_PID
  COMPILE_EXIT=$?

  wait $CREDO_PID
  CREDO_EXIT=$?

  wait $TEST_PID
  TEST_EXIT=$?

  echo ""
  if [ $COMPILE_EXIT -eq 0 ] && [ $CREDO_EXIT -eq 0 ] && [ $TEST_EXIT -eq 0 ]; then
    echo "✅ All validations passed"
    echo ""
    echo "📢 Running make publish-release..."
    make publish-release
  else
    echo "⚠️  Validation failed (see logs below)"
    [ $COMPILE_EXIT -ne 0 ] && echo "  ❌ Compile failed - see $COMPILE_LOG"
    [ $CREDO_EXIT -ne 0 ] && echo "  ❌ Credo failed - see $CREDO_LOG"
    [ $TEST_EXIT -ne 0 ] && echo "  ❌ Tests failed - see $TEST_LOG"
    echo ""
    echo "Full validation log: $LOG_FILE"
    exit 1
  fi
} 2>&1 | tee "$LOG_FILE" &

echo "✓ Post-push validation running in background"
echo "  Log: $LOG_FILE"
